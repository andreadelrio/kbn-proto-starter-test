{
  "name": "kbn-proto-starter",
  "private": true,
  "version": "2.0.0",
  "description": "A starter for coded Kibana prototypes, with Kibana's chrome from kbn-proto-ui.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p . && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p .",
    "lint": "eslint --max-warnings=0 .",
    "check": "npm run typecheck && npm run lint",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@elastic/charts": "^73.4.1",
    "@elastic/datemath": "^5.0.3",
    "@elastic/eui": "^123.5.0",
    "@elastic/eui-theme-borealis": "^8.1.0",
    "@elastic/kbn-proto-ui": "github:elastic/kbn-proto-ui#v0.10.0",
    "@emotion/css": "^11.13.5",
    "@emotion/react": "^11.14.0",
    "moment": "^2.30.1",
    "moment-timezone": "^0.5.48",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "simple-git-hooks": {
    "pre-commit": "npm run check"
  },
  "devDependencies": {
    "@elastic/eslint-plugin-eui": "^4.0.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9.39.5",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vite-plugin-checker": "^1.0.0"
  }
}
